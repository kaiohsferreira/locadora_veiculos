# Copie este arquivo para ".env" e ajuste os valores.

# URL base da API do backend (ASP.NET Core).
VITE_API_URL=http://localhost:5000

# Enquanto o login (tarefa P2-BE-01) não existe, "true" libera as rotas protegidas
# (área do cliente e back office) para navegar no desenvolvimento.
# Só tem efeito no "npm run dev": no build de produção a proteção sempre vale.
# Troque para "false" quando o login estiver pronto.
VITE_IGNORAR_AUTENTICACAO=true
