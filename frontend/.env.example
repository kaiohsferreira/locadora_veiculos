# Copie este arquivo para ".env" e ajuste os valores.

# URL base da API do backend (ASP.NET Core).
VITE_API_URL=http://localhost:5000

# O login já existe (POST /api/auth/login). "true" libera as rotas protegidas
# (área do cliente e back office) sem passar pela API, só para navegar no
# "npm run dev" quando o backend não está rodando.
# Só tem efeito no "npm run dev": no build de produção a proteção sempre vale.
VITE_IGNORAR_AUTENTICACAO=false
