{
  "ConnectionStrings": {
    "AutoViaConnection": "Host=localhost;Port=5432;Database=autovia;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "AutoVia.Api",
    "Audiencia": "AutoVia.Web",
    "ExpiracaoMinutos": 120,
    "ExpiracaoLembrarDias": 30
  },
  "Clientes": {
    "LimiteVerificacaoCadastroPorMinuto": 30
  },
  "Autenticacao": {
    "LimitePublicoPorMinuto": 10,
    "Sessao": {
      "CacheSegundos": 60
    },
    "Recuperacao": {
      "UrlPublicaFront": "http://localhost:5173",
      "ValidadeMinutos": 30,
      "LimitePorHora": 3,
      "TempoMinimoRespostaMs": 400
    }
  }
}
