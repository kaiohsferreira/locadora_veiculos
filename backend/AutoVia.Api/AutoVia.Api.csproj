<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Camada web: controllers, injecao de dependencia (Extensions/Add*Startup.cs),
    filtros, middleware de erro e Swagger. Depende de todos os outros projetos.
  -->

  <PropertyGroup>
    <!-- XML de documentacao para o Swagger exibir os /// <summary> dos endpoints. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoVia.Core\AutoVia.Core.csproj" />
    <ProjectReference Include="..\AutoVia.Communication\AutoVia.Communication.csproj" />
    <ProjectReference Include="..\AutoVia.Helpers\AutoVia.Helpers.csproj" />
    <ProjectReference Include="..\AutoVia.Infrastructure\AutoVia.Infrastructure.csproj" />
    <ProjectReference Include="..\AutoVia.Integrations\AutoVia.Integrations.csproj" />
  </ItemGroup>

</Project>
