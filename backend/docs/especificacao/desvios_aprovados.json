{
  "aprovado_por": "Kaio Henrique dos Santos Ferreira",
  "data": "2026-11-04",
  "motivo": "Todas as entidades herdam BaseEntities (exclusao logica com disabled_at). Com soft delete, a unicidade e regra de codigo (servico + repositorio filtrando disabled_at nulo): nenhum indice unico no banco.",
  "colunas_auditoria": {
    "tabelas": "todas",
    "colunas": {
      "created_at": { "tipo": "timestamp without time zone", "not_null": true, "default": "current_timestamp" },
      "updated_at": { "tipo": "timestamp without time zone", "not_null": true, "default": "current_timestamp" },
      "disabled_at": { "tipo": "timestamp without time zone", "not_null": false, "default": null }
    }
  },
  "unique_para_indice": {
    "categoria_nome_key": "idx_categoria_nome",
    "cliente_cpf_key": "idx_cliente_cpf",
    "cliente_cnh_numero_key": "idx_cliente_cnh_numero",
    "funcionario_cpf_key": "idx_funcionario_cpf",
    "funcionario_matricula_key": "idx_funcionario_matricula",
    "veiculo_placa_key": "idx_veiculo_placa",
    "veiculo_chassi_key": "idx_veiculo_chassi",
    "veiculo_renavam_key": "idx_veiculo_renavam",
    "locacao_id_reserva_key": "idx_locacao_reserva",
    "venda_id_veiculo_key": "idx_venda_veiculo",
    "venda_numero_nota_fiscal_key": "idx_venda_numero_nota_fiscal",
    "seguro_numero_apolice_key": "idx_seguro_numero_apolice",
    "uq_vistoria_locacao_tipo": "idx_vistoria_locacao_tipo",
    "integration_codigo_key": "idx_integration_codigo",
    "uq_setting_chave": "idx_setting_chave"
  },
  "colunas_acesso": {
    "aprovado_por": "Kaio Henrique dos Santos Ferreira",
    "data": "2026-11-05",
    "motivo": "RF-06 exige autenticacao e a especificacao nao define onde guardar a credencial. Decisao D1: coluna senha_hash. Guarda somente o hash PBKDF2, nunca a senha.",
    "colunas": {
      "cliente": { "senha_hash": "VARCHAR(255) NULL" },
      "funcionario": { "senha_hash": "VARCHAR(255) NULL" }
    }
  },
  "sinistro_acompanhamento": {
    "aprovado_por": "Kaio Henrique dos Santos Ferreira",
    "data": "2026-11-13",
    "tarefa": "P9-INT-01",
    "motivo": "RF-43 exige linha do tempo do sinistro com autor e data de cada mudanca de status, mas a tabela sinistro so guarda o status atual. O acompanhamento junto a seguradora tambem precisa do protocolo devolvido por ela na abertura.",
    "colunas": {
      "sinistro": { "protocolo_seguradora": "VARCHAR(40) NULL" }
    },
    "tabelas_novas": {
      "sinistro_historico": {
        "colunas": {
          "id_sinistro_historico": "SERIAL PRIMARY KEY",
          "id_sinistro": "INTEGER NOT NULL, FK fk_sinistro_historico_sinistro -> sinistro (id_sinistro)",
          "status_anterior": "VARCHAR(20) NULL",
          "status_novo": "VARCHAR(20) NOT NULL",
          "origem": "VARCHAR(20) NOT NULL",
          "id_funcionario": "INTEGER NULL, FK fk_sinistro_historico_funcionario -> funcionario (id_funcionario)",
          "observacao": "VARCHAR(500) NULL",
          "data_alteracao": "TIMESTAMP NOT NULL",
          "created_at / updated_at / disabled_at": "auditoria padrao (colunas_auditoria)"
        },
        "checks": {
          "ck_sinistro_historico_status_anterior": "status_anterior IS NULL OR status_anterior IN ('ABERTO', 'EM_ANALISE', 'APROVADO', 'NEGADO', 'ENCERRADO')",
          "ck_sinistro_historico_status_novo": "status_novo IN ('ABERTO', 'EM_ANALISE', 'APROVADO', 'NEGADO', 'ENCERRADO')",
          "ck_sinistro_historico_origem": "origem IN ('FUNCIONARIO', 'SEGURADORA')",
          "ck_sinistro_historico_funcionario": "origem <> 'FUNCIONARIO' OR id_funcionario IS NOT NULL"
        },
        "indices": { "idx_sinistro_historico_sinistro": "id_sinistro, data_alteracao" }
      }
    },
    "dados": {
      "integration_setting": { "SEGURADORA.provedor": "FAKE (migration de dados SeguradoraProvedor; mesmo padrao de AjustarIntegracoesProvedores)" }
    }
  }
}
